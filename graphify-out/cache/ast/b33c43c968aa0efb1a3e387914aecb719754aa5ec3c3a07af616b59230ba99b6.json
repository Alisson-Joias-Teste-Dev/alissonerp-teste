     if (!isOrcamento) {\r\n        const semProduto = itens.filter(i => !i.produto_id || !tinyIdMap.has(Number(i.produto_id)));\r\n        if (semProduto.length > 0) {\r\n          throw new Error(`Produto \"${semProduto[0].nome_produto}\" n\u00e3o est\u00e1 cadastrado no Tiny. Vincule o produto antes de aprovar.`);\r\n        }\r\n      }\r\n\r\n      return itens.map((item) => {\r\n        const tinyProdId = tinyIdMap.get(Number(item.produto_id));\r\n        const prodId = tinyProdId || (isOrcamento ? TINY_PRODUTO_GENERICO : 0);\r\n        return {\r\n          produto: {\r\n            id: prodId,\r\n            ...(item.sku ? { codigo: item.sku } : {}),\r\n            descricao: item.nome_produto || \"Produto\",\r\n            tipo: \"P\",\r\n          },\r\n          quantidade: Number(item.quantidade),\r\n          valorUnitario: Number(item.preco_unitario),\r\n          ...(item.observacao ? { infoAdicional: item.observacao } : {}),\r\n        };\r\n      });\r\n    })", "is_member_call": false, "source_file": "/mnt/c/Users/Jonathan Ara\u00fajo/onedrive/fabricaAj/src/lib/vendas-aprovar.ts", "source_location": "L241"}, {"caller_nid": "lib_vendas_aprovar_sendtotiny", "callee": "enviarParaTiny", "is_member_call": false, "source_file": "/mnt/c/Users/Jonathan Ara\u00fajo/onedrive/fabricaAj/src/lib/vendas-aprovar.ts", "source_location": "L281"}, {"caller_nid": "lib_vendas_aprovar_sendtotiny", "callee": "enviarParaTiny", "is_member_call": false, "source_file": "/mnt/c/Users/Jonathan Ara\u00fajo/onedrive/fabricaAj/src/lib/vendas-aprovar.ts", "source_location": "L286"}, {"caller_nid": "lib_vendas_aprovar_sendtotiny", "callee": "sql", "is_member_call": false, "source_file": "/mnt/c/Users/Jonathan Ara\u00fajo/onedrive/fabricaAj/src/lib/vendas-aprovar.ts", "source_location": "L291"}, {"caller_nid": "lib_vendas_aprovar_sendtotiny", "callee": "text", "is_member_call": true, "source_file": "/mnt/c/Users/Jonathan Ara\u00fajo/onedrive/fabricaAj/src/lib/vendas-aprovar.ts", "s