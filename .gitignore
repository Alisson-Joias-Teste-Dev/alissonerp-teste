# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# APK build artifacts
android-rfid-app/app/build/
android-rfid-app/.gradle/
# APK e baixado via GitHub Actions e copiado manualmente para producao

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Allow versioned env templates (no secrets)
!.env.example
!env/.env.homolog.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database dumps
*.dump
*.sql.gz
/backups/

# arquivos acidentais
/0

# config local do Claude Code (permissões do usuário, paths absolutos)
/.claude/

# relatórios locais gerados (scripts hardcoded + binários)
/gerar_relatorio.js
/gerar_relatorio.py
/relatorio_*.xlsx

# Environment & Secrets (AIOX)
.env
.env.local
.env.*.local
*.key

# Dependencies (AIOX)
node_modules/

# Build & Logs (AIOX)
dist/
build/
*.log
logs/

# IDE & OS (AIOX)
Thumbs.db
.idea/
*.swp

# AIOX Local (AIOX)
.aiox-core/local/
.claude/settings.local.json
.aiox/install-log.txt

# Python virtual env
.venv/

# playwright (robo de teste de tela)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
