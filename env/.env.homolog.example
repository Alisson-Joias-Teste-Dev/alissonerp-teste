# ============================================
# Alisson ERP — Banco de Homologação (TESTE)
# ============================================
# Copie este arquivo para .env.homolog e preencha a senha.
#
#   cp env/.env.homolog.example .env.homolog
#
# Depois edite .env.homolog substituindo <SENHA_HOMOLOG> pela senha real.
#
# NUNCA commite .env.homolog com senha real.
# ============================================

# Banco de teste / homologação
# Host: cloud.alisson.api.br:5435
# Database: postgres-homolog
DATABASE_URL=postgresql://postgres:<SENHA_HOMOLOG>@cloud.alisson.api.br:5435/postgres-homolog?sslmode=disable

# Variável que ativa o badge visual "HOMOLOG - BANCO DE TESTE" no topo da tela
NEXT_PUBLIC_AMBIENTE=homolog

# Modo desenvolvimento (desabilita otimizações de produção)
NODE_ENV=development

# Supabase (ambiente de homologação)
# Preencha com as chaves do projeto Supabase de homologação
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push — chaves VAPID (podem ser as mesmas de produção para teste)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@alissonjoias.com.br
